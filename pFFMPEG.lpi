              <RunWithoutDebug Value="True"/>
            </Debugging>
            <LinkSmart Value="True"/>
            <Options>
              <Win32>
                <GraphicApplication Value="True"/>
              </Win32>
            </Options>
          </Linking>
          <Other>
            <CompilerMessages>
              <IgnoredMessages idx6058="True" idx5062="True" idx4046="True"/>
            </CompilerMessages>
          </Other>
        </CompilerOptions>
      </Item>
    </BuildModes>
    <PublishOptions>
